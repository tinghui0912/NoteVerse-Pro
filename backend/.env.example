# 应用配置
PROJECT_NAME=MelodyForge
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=noteverse_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
DEBUG=false

# CORS
BACKEND_CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002,http://localhost:3000,http://localhost:8080

# 数据库
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/melody_forge?charset=utf8mb4
SYNC_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/melody_forge?charset=utf8mb4

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 文件存储
UPLOAD_FOLDER=../backend/var/uploads
OUTPUT_FOLDER=../backend/var/output
TEMP_FOLDER=../backend/var/temp
MAX_PROCESSING_TIME=300

# 外部工具
AUDIVERIS_PATH=C:/Program Files/Audiveris/Audiveris.exe
MUSESCORE_PATH=C:/Program Files/MuseScore 4/bin/MuseScore4.exe

# 邮件配置
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password-here
MAIL_DEFAULT_SENDER=your-email@example.com

# Email 验证
EMAIL_CODE_TTL_SECONDS=180
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_VERIFY_TOKEN_MAX_AGE_SECONDS=900
