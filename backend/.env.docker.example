# Copy this file to backend/.env.docker before running docker compose.
# Redis and database are expected to keep running on the Windows host.

# Application
PROJECT_NAME=NoteVerse Pro
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
DEBUG=true
FRONTEND_BASE_URL=http://localhost:3000
LOG_FORMAT=console

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=noteverse_session
REFRESH_COOKIE_NAME=noteverse_refresh
CSRF_COOKIE_NAME=noteverse_csrf
CSRF_HEADER_NAME=x-csrf-token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Host services
DATABASE_URL=postgresql+asyncpg://postgres:password@host.docker.internal:5432/noteverse_pro
SYNC_DATABASE_URL=postgresql+psycopg://postgres:password@host.docker.internal:5432/noteverse_pro
# Must be a direct PostgreSQL endpoint or PgBouncer session-pooling endpoint.
# Do not use a transaction-pooling endpoint for PostgreSQL advisory locks.
SCHEDULER_LOCK_DATABASE_URL=postgresql+psycopg://postgres:password@host.docker.internal:5432/noteverse_pro
SCHEDULER_LOCK_STATEMENT_TIMEOUT_MILLISECONDS=5000
SCHEDULER_LOCK_TCP_USER_TIMEOUT_MILLISECONDS=30000
REDIS_URL=redis://host.docker.internal:6379/0
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/0

# CORS
# Add your LAN frontend origin when testing from another device, e.g. http://192.168.31.59:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Keep empty for direct local access. Add only CIDRs of reverse proxies that
# normalize and append forwarding headers.
TRUSTED_PROXY_CIDRS=[]

# Task reliability
IMPORT_DISPATCH_INTERVAL_SECONDS=30
IMPORT_DISPATCH_TIMEOUT_SECONDS=300
IMPORT_PROCESSING_TIMEOUT_SECONDS=1200
IMPORT_DISPATCH_MAX_ATTEMPTS=3
IMPORT_DISPATCH_BATCH_SIZE=20
NOTIFICATION_CLEANUP_INTERVAL_SECONDS=86400
REALTIME_EVENT_CLEANUP_INTERVAL_SECONDS=86400
REALTIME_EVENT_RETENTION_DAYS=7
RENDER_OUTBOX_DISPATCH_INTERVAL_SECONDS=30
RENDER_OUTBOX_DISPATCH_TIMEOUT_SECONDS=300
RENDER_OUTBOX_PROCESSING_TIMEOUT_SECONDS=1200
RENDER_OUTBOX_RETRY_BASE_SECONDS=60
RENDER_OUTBOX_MAX_ATTEMPTS=5
RENDER_OUTBOX_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_DISPATCH_INTERVAL_SECONDS=10
MAIL_OUTBOX_DISPATCH_TIMEOUT_SECONDS=120
MAIL_OUTBOX_PROCESSING_TIMEOUT_SECONDS=120
MAIL_OUTBOX_RETRY_BASE_SECONDS=30
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=90
ORPHAN_UPLOAD_TTL_SECONDS=86400

# File storage
FILE_STORAGE_BACKEND=local
STORAGE_ROOT=data/storage
WORK_ROOT=data/work
MAX_PROCESSING_TIME=900
FINGERING_MAX_CONCURRENCY=2
FINGERING_QUEUE_WAIT_SECONDS=5
FINGERING_MAX_CONTENT_BYTES=2097152
CELERY_TASK_SOFT_TIME_LIMIT=960
CELERY_TASK_TIME_LIMIT=1020

# S3-compatible storage
# FILE_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://oss-cn-shenzhen.aliyuncs.com
# S3_REGION=cn-shenzhen
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-access-key-secret
# S3_PUBLIC_BASE_URL=https://your-bucket-name.oss-cn-shenzhen.aliyuncs.com
# S3_FORCE_PATH_STYLE=false
# S3_PRESIGN_EXPIRE_SECONDS=900

# Mail
# Production should use a product-owned transactional email provider/domain.
MAIL_DEFAULT_SENDER=NoteVerse Pro <no-reply@example.com>
RESEND_API_KEY=re_your-api-key

# Email verification
EMAIL_VERIFY_TOKEN_MAX_AGE_SECONDS=900
