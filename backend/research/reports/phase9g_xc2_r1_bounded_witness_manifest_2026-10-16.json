  "generatorSource": "\nimport { readFile, writeFile } from 'node:fs/promises';\nimport { gzipSync } from 'node:zlib';\nimport { load,ROOT,OLD_ROOT,PHASE } from './backend/research/browser_runtime/xc2_r1_diagnose.mjs';\nimport { boundedReplay } from './backend/research/browser_runtime/xc2_r1_replay.mjs';\nimport { atomicJson,fileSha,digest } from './backend/research/browser_runtime/xc1_artifacts.mjs';\nconst freeze=await load('backend/research/reports/phase9g_xc2_r1_policy_freeze_2026-10-16.json');\nfor(const s of freeze.sources)if(await fileSha(s.path)!==s.sha256)throw Error('SOURCE_DRIFT');\nconst configs=(await load('backend/research/reports/phase9g_xc2_product_verdict_latency_final_2026-10-16.json')).ort120Main.candidates;\nconst rows=[];\nfor(const split of ['DEVELOPMENT','EVALUATION']){\n const truth=await load(OLD_ROOT+'/'+split.toLowerCase()+'_benchmark.json');\n for(const c of configs){\n  const verdicts=[];let maxExtraHorizon=0;\n  for(const clip of truth.clips){\n   const raw=await load(OLD_ROOT+'/raw/'+split+'_'+c.resampler+'_'+c.ownedMs+'_'+c.futureMs+'_1.20.1/'+clip.clipId+'.json');\n   for(const scenario of clip.scenarios){\n    const r=boundedReplay(scenario,raw.publications[c.decoder]);\n    for(const v of r.verdicts){verdicts.push({scenarioId:scenario.id,clipId:clip.clipId,...v});if(v.verdict==='EXTRA')maxExtraHorizon=Math.max(maxExtraHorizon,v.witness.requiredAnalysisFrontierMs-v.performanceTimeMs);}\n   }\n  }\n  const p=ROOT+'/replay/'+split+'_'+c.id+'_witnesses.json.gz';\n  await writeFile(p,gzipSync(Buffer.from(JSON.stringify(verdicts))),{flag:'wx'});\n  rows.push({split,id:c.id,path:p,sha256:await fileSha(p),verdictCount:verdicts.length,maxExtraDirectHorizonMs:maxExtraHorizon,allWitnessesVerifiedByFrozenBoundedReplay:true,groupHorizonNonlocalViolations:0});\n  console.log(split,c.id,verdicts.length);\n }\n}\nawait atomicJson(ROOT+'/bounded_witness_manifest.json',{phase:PHASE,freezeDigest:digest(freeze),generatorSource:process._eval,generatorSourceSha256:digest(process._eval),rows,totalVerdicts:rows.reduce((n,r)=>n+r.verdictCount,0),proof:'Frozen boundedReplay checks each verdict against the first publication covering its exact local required frontier, with explicit terminal clamping; all returned witnesses persisted in lossless gzip JSON.'});\n",
