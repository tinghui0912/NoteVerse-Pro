            "title": "Event Type",
            "type": "string"
          },
          "note_number": {
            "maximum": 127,
            "minimum": 0,
            "title": "Note Number",
            "type": "integer"
          },
          "timestamp_ms": {
            "minimum": 0,
            "title": "Timestamp Ms",
            "type": "integer"
          },
          "velocity": {
            "default": 0,
            "maximum": 127,
            "minimum": 0,
            "title": "Velocity",
            "type": "integer"
          }
        },
        "required": [
          "event_type",
          "note_number",
          "timestamp_ms"
