            "type": "string"
          }
        },
        "required": [
          "payload"
        ],
        "title": "PerformanceClockSyncMessage",
        "type": "object"
      },
      "PerformanceClockSyncPayload": {
        "additionalProperties": false,
        "properties": {
          "count_in_remaining_ms": {
            "minimum": 0.0,
            "title": "Count In Remaining Ms",
            "type": "number"
          },
          "count_in_remaining_pulses": {
            "minimum": 0.0,
            "title": "Count In Remaining Pulses",
            "type": "number"
          },
          "musical_beat": {
            "title": "Musical Beat",
            "type": "number"
          },
          "nominal_scope_duration_ms": {
            "minimum": 0.0,
            "title": "Nominal Scope Duration Ms",
            "type": "number"
          },
          "performance_time_ms": {
            "minimum": 0.0,
            "title": "Performance Time Ms",
            "type": "number"
          },
          "scope_completed": {
            "title": "Scope Completed",
            "type": "boolean"
          },
          "scope_end_group_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scope End Group Id"
          },
          "scope_start_beat": {
            "title": "Scope Start Beat",
            "type": "number"
          },
          "scope_start_group_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scope Start Group Id"
          },
          "scope_terminal_beat": {
            "title": "Scope Terminal Beat",
            "type": "number"
          },
          "speed_ratio": {
            "exclusiveMinimum": 0.0,
            "title": "Speed Ratio",
            "type": "number"
          },
          "state": {
            "enum": [
              "READY",
              "COUNT_IN",
              "RUNNING",
              "PAUSED",
              "ENDED"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "musical_beat",
          "performance_time_ms",
          "count_in_remaining_ms",
          "count_in_remaining_pulses",
          "scope_completed",
          "scope_start_beat",
          "scope_terminal_beat",
          "nominal_scope_duration_ms",
          "speed_ratio"
        ],
        "title": "PerformanceClockSyncPayload",
        "type": "object"
      },
