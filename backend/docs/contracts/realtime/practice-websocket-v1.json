        "title": "ClientMidiEventPayload",
        "type": "object"
      },
      "ClientPauseMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/ClientTimestampPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "client.pause",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "title": "ClientPauseMessage",
        "type": "object"
      },
      "ClientResumeMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/ClientTimestampPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "client.resume",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "title": "ClientResumeMessage",
        "type": "object"
      },
      "ClientTimestampPayload": {
        "additionalProperties": false,
        "properties": {
          "t": {
            "minimum": 0,
            "title": "T",
            "type": "integer"
          }
        },
        "required": [
          "t"
        ],
        "title": "ClientTimestampPayload",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "client.finish": "#/$defs/ClientFinishMessage",
        "client.heartbeat": "#/$defs/ClientHeartbeatMessage",
        "client.init": "#/$defs/ClientInitMessage",
        "client.midi_event": "#/$defs/ClientMidiEventMessage",
        "client.pause": "#/$defs/ClientPauseMessage",
        "client.resume": "#/$defs/ClientResumeMessage"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/ClientInitMessage"
      },
      {
        "$ref": "#/$defs/ClientPauseMessage"
      },
      {
        "$ref": "#/$defs/ClientResumeMessage"
      },
      {
        "$ref": "#/$defs/ClientFinishMessage"
      },
      {
        "$ref": "#/$defs/ClientHeartbeatMessage"
      },
      {
        "$ref": "#/$defs/ClientMidiEventMessage"
      }
    ]
  },
  "compatibility": {
    "breaking_change": "new_protocol_version",
    "legacy_fallback": "forbidden",
    "within_version": "additive_only"
  },
  "description": "Versioned JSON control and server-event frames for Practice WebSocket sessions. Binary PCM frames use the REST-negotiated session audio format.",
  "protocol_version": 1,
  "server_messages": {
    "$defs": {
      "AlignmentDecisionPayload": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "advance",
              "hold",
              "wait"
            ],
            "title": "Action",
            "type": "string"
          },
          "attempt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Id"
          },
          "attempt_resolved_at_ms": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Resolved At Ms"
          },
          "attempt_sequence": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Sequence"
          },
          "attempt_started_at_ms": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Started At Ms"
          },
          "attempt_state": {
            "anyOf": [
              {
                "enum": [
                  "pending",
                  "resolved"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt State"
          },
          "confidence_summary": {
            "$ref": "#/$defs/PracticeConfidenceSummaryPayload"
          },
          "display_anchor": {
            "anyOf": [
              {
                "$ref": "#/$defs/PracticeDisplayAnchorPayload"
              },
              {
                "type": "null"
              }
            ]
          },
          "evaluator_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evaluator Version"
          },
          "experience_state": {
            "enum": [
              "waiting_for_input",
              "listening",
              "following",
              "partially_matched",
              "heard_but_uncertain",
              "possible_wrong_note",
              "recovering",
              "lost",
              "paused"
            ],
            "title": "Experience State",
            "type": "string"
          },
          "policy_profile_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Policy Profile Version"
          },
          "reason": {
            "enum": [
              "stable_match",
              "partial_match",
              "insufficient_input",
              "entry_mismatch",
              "low_alignment_confidence",
              "holding_position",
              "reacquiring",
              "large_jump"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "action",
          "reason",
          "experience_state",
          "display_anchor",
          "confidence_summary"
        ],
        "title": "AlignmentDecisionPayload",
        "type": "object"
      },
      "AlignmentUpdateMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/AlignmentUpdatePayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
