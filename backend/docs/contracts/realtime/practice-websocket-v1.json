            "const": "alignment.update",
            "default": "alignment.update",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "payload"
        ],
        "title": "AlignmentUpdateMessage",
        "type": "object"
      },
      "AlignmentUpdatePayload": {
        "additionalProperties": false,
        "properties": {
          "alignment_confidence": {
            "title": "Alignment Confidence",
            "type": "number"
          },
          "alignment_state": {
            "minLength": 1,
            "title": "Alignment State",
            "type": "string"
          },
          "audio_active": {
            "title": "Audio Active",
            "type": "boolean"
          },
          "audio_confidence": {
            "title": "Audio Confidence",
            "type": "number"
          },
          "beat_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Beat Delta"
          },
          "beat_position": {
            "title": "Beat Position",
            "type": "number"
          },
          "beat_velocity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Beat Velocity"
          },
          "completion_reason": {
            "anyOf": [
              {
                "enum": [
                  "FULL_SCORE_END_REACHED",
                  "SCOPE_END_REACHED",
                  "FINAL_EXPECTED_GROUP_MATCHED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completion Reason"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "continuity_confidence": {
            "title": "Continuity Confidence",
            "type": "number"
          },
          "continuity_state": {
            "minLength": 1,
            "title": "Continuity State",
            "type": "string"
          },
          "decision": {
            "$ref": "#/$defs/AlignmentDecisionPayload"
          },
          "feature_confidence": {
            "title": "Feature Confidence",
            "type": "number"
          },
          "frame_class": {
            "enum": [
              "silence",
              "transient",
              "tonal",
              "uncertain",
              "unknown"
            ],
            "title": "Frame Class",
            "type": "string"
          },
          "gate_reason": {
            "minLength": 1,
            "title": "Gate Reason",
            "type": "string"
          },
          "input_health": {
            "$ref": "#/$defs/InputHealthPayload"
          },
          "input_peak": {
            "title": "Input Peak",
            "type": "number"
          },
          "input_policy_confidence": {
            "title": "Input Policy Confidence",
            "type": "number"
          },
          "input_rms": {
            "title": "Input Rms",
            "type": "number"
          },
          "input_weight": {
            "title": "Input Weight",
            "type": "number"
          },
          "match_state": {
            "enum": [
              "matched",
              "holding_decay",
              "lost",
              "no_input"
            ],
            "title": "Match State",
            "type": "string"
          },
          "onset_signal": {
            "title": "Onset Signal",
            "type": "boolean"
          },
          "peak_prominence": {
            "title": "Peak Prominence",
            "type": "number"
          },
          "queue_decision": {
            "minLength": 1,
            "title": "Queue Decision",
            "type": "string"
          },
          "scope_completed": {
            "title": "Scope Completed",
            "type": "boolean"
          },
          "spectral_flatness": {
            "title": "Spectral Flatness",
            "type": "number"
          },
          "spectral_flux": {
            "title": "Spectral Flux",
            "type": "number"
          },
          "stream_state": {
            "minLength": 1,
            "title": "Stream State",
            "type": "string"
          },
          "timestamp_ms": {
            "minimum": 0,
            "title": "Timestamp Ms",
            "type": "integer"
          },
          "tonal_signal": {
            "title": "Tonal Signal",
            "type": "boolean"
          },
          "validation_confidence": {
            "title": "Validation Confidence",
            "type": "number"
          },
          "visual_confidence": {
            "title": "Visual Confidence",
            "type": "number"
          }
        },
        "required": [
          "beat_position",
          "confidence",
          "alignment_confidence",
          "audio_confidence",
          "continuity_confidence",
          "visual_confidence",
          "timestamp_ms",
          "scope_completed",
          "completion_reason",
          "audio_active",
          "input_rms",
          "input_peak",
          "input_health",
          "match_state",
          "feature_confidence",
          "beat_delta",
          "stream_state",
          "frame_class",
          "gate_reason",
          "queue_decision",
          "tonal_signal",
          "onset_signal",
          "spectral_flatness",
          "peak_prominence",
          "spectral_flux",
          "alignment_state",
          "continuity_state",
          "beat_velocity",
          "validation_confidence",
          "input_weight",
          "input_policy_confidence",
          "decision"
        ],
        "title": "AlignmentUpdatePayload",
        "type": "object"
      },
      "InputHealthPayload": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "level": {
            "enum": [
              "good",
              "too_quiet",
              "clipping"
            ],
            "title": "Level",
            "type": "string"
          },
          "noise": {
            "enum": [
              "good",
              "elevated",
              "high"
            ],
            "title": "Noise",
            "type": "string"
          }
        },
        "required": [
          "available",
          "level",
          "noise",
          "confidence"
        ],
        "title": "InputHealthPayload",
        "type": "object"
      },
      "PerformanceClockSyncMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/PerformanceClockSyncPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "performance.clock_sync",
            "default": "performance.clock_sync",
