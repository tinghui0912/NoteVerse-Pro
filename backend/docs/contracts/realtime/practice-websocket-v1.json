        "title": "ClientInitPayload",
        "type": "object"
      },
      "ClientMidiEventMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/ClientMidiEventPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "client.midi_event",
            "title": "Type",
            "type": "string"
