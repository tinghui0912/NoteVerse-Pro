{
  "$id": "https://noteverse.local/contracts/realtime/practice-websocket-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "client_messages": {
    "$defs": {
      "ClientFinishMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/ClientTimestampPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "client.finish",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "title": "ClientFinishMessage",
        "type": "object"
      },
      "ClientHeartbeatMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/ClientTimestampPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "client.heartbeat",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "title": "ClientHeartbeatMessage",
        "type": "object"
      },
      "ClientInitMessage": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$ref": "#/$defs/ClientInitPayload"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "type": {
            "const": "client.init",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "title": "ClientInitMessage",
        "type": "object"
      },
      "ClientInitPayload": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "minimum": 1,
            "title": "Channels",
            "type": "integer"
          },
          "evaluation_profile": {
            "enum": [
              "LEARNING",
              "PERFORMANCE"
            ],
            "title": "Evaluation Profile",
            "type": "string"
          },
          "frame_samples": {
            "minimum": 1,
            "title": "Frame Samples",
            "type": "integer"
          },
          "input_source": {
            "enum": [
              "MICROPHONE",
              "MIDI"
            ],
            "title": "Input Source",
            "type": "string"
          },
          "progression_mode": {
            "enum": [
              "WAIT_FOR_NOTE",
              "CONTINUOUS"
            ],
            "title": "Progression Mode",
            "type": "string"
          },
          "realtime_guidance": {
            "enum": [
              "STATUS_ONLY",
              "GUIDED"
            ],
