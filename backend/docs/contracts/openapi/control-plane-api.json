              ],
              "title": "Created After"
            }
          },
          {
            "in": "query",
            "name": "updated_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Updated Before"
            }
          },
          {
            "in": "cookie",
            "name": "noteverse_operator_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Noteverse Operator Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OffsetPage_AsyncOperationRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "List Async Operations",
        "tags": [
