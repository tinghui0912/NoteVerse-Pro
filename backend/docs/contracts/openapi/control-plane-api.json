  "info": {
    "description": "Platform operator API",
    "title": "NoteVerse Pro Control Plane API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "operatorLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperatorLoginCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Login Operator",
        "tags": [
          "Operator Authentication"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "operatorLogout",
        "parameters": [
          {
            "in": "cookie",
            "name": "noteverse_operator_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Noteverse Operator Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Logout Operator",
        "tags": [
          "Operator Authentication"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "operatorCurrentGet",
        "parameters": [
          {
            "in": "cookie",
            "name": "noteverse_operator_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Noteverse Operator Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Current Operator",
        "tags": [
          "Operator Authentication"
        ]
      }
    },
