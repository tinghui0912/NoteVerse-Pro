# Process inputs for control_plane; copy to the same filename without .example.
PROJECT_NAME=NoteVerse Pro
DEBUG=true
LOG_FORMAT=console
DATABASE_URL=postgresql+psycopg://nv_control_plane:replace-with-control-plane-password@host.docker.internal:5432/noteverse_pro
REDIS_URL=redis://host.docker.internal:6379/0
TRUSTED_PROXY_CIDRS=[]
TRUSTED_PROXY_HOPS=0
IMPORT_DISPATCH_INTERVAL_SECONDS=30
IMPORT_DISPATCH_TIMEOUT_SECONDS=300
IMPORT_PROCESSING_TIMEOUT_SECONDS=1200
IMPORT_DISPATCH_MAX_ATTEMPTS=3
IMPORT_DISPATCH_BATCH_SIZE=20
REVISION_RENDER_DISPATCH_INTERVAL_SECONDS=30
REVISION_RENDER_DISPATCH_TIMEOUT_SECONDS=300
REVISION_RENDER_PROCESSING_TIMEOUT_SECONDS=1200
REVISION_RENDER_RETRY_BASE_SECONDS=60
REVISION_RENDER_MAX_ATTEMPTS=5
REVISION_RENDER_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_DISPATCH_INTERVAL_SECONDS=10
MAIL_OUTBOX_DISPATCH_TIMEOUT_SECONDS=120
MAIL_OUTBOX_PROCESSING_TIMEOUT_SECONDS=120
MAIL_OUTBOX_RETRY_BASE_SECONDS=30
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_RETENTION_DAYS=7
ORPHAN_UPLOAD_TTL_SECONDS=86400
CONTROL_PLANE_COOKIE_SECURE=false
CONTROL_PLANE_CORS_ORIGINS=["http://localhost:3001"]

# Generate a separate key with cryptography.fernet.Fernet.generate_key().
OPERATOR_TOTP_ENCRYPTION_KEY=
