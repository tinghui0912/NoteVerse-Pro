# Copy this file to backend/.env.docker.worker before starting the Worker.
# Benchmark against model size, GPU memory, queue latency, and retry SLOs before
# increasing this value in a production deployment.
CELERY_WORKER_CONCURRENCY=1

# Offline model assets and processing engines
MODEL_ROOT=/opt/noteverse/models
HF_HOME=/opt/noteverse/models/huggingface
HF_MODEL_REPOSITORIES=["guangyangmusic/legato","meta-llama/Llama-3.2-11B-Vision"]
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=true
PADDLEOCR_MODEL_ROOT=/opt/noteverse/models/paddleocr/official_models
PADDLEOCR_DETECTION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-OCRv6_medium_det
PADDLEOCR_RECOGNITION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-OCRv6_medium_rec
PADDLEOCR_TEXTLINE_ORIENTATION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-LCNet_x1_0_textline_ori
PADDLEOCR_TIMEOUT_SECONDS=300
OMR_ENGINE=legato
LEGATO_REPO_PATH=/opt/noteverse/legato
LEGATO_REPO_COMMIT=179c228d3d5f67113cf739b44891b3abe046f1dc
LEGATO_PYTHON=python3
LEGATO_MODEL_PATH=guangyangmusic/legato
LEGATO_PROCESSOR_PATH=guangyangmusic/legato
LEGATO_DEVICE=cuda
LEGATO_FP16=true
LEGATO_BEAM_SIZE=10
LEGATO_BATCH_SIZE=1
LEGATO_TIMEOUT_SECONDS=600
SCORE_RENDER_ENGINE=verovio
VEROVIO_PAGE_WIDTH=2100
VEROVIO_PAGE_HEIGHT=2970
VEROVIO_SCALE=40
VEROVIO_BREAKS=encoded
VEROVIO_ADJUST_PAGE_HEIGHT=false
VEROVIO_JUSTIFY_VERTICALLY=true
VEROVIO_PAGE_MARGIN_TOP=390
VEROVIO_PAGE_MARGIN_BOTTOM=80
VEROVIO_HEADER=none
VEROVIO_FOOTER=always
VEROVIO_USE_PG_FOOTER_FOR_ALL=true
VEROVIO_PREVIEW_HEADER_POSTPROCESSING=true
