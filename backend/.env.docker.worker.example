# Process inputs for worker; copy to the same filename without .example.
PROJECT_NAME=NoteVerse Pro
DEBUG=true
LOG_FORMAT=console
DATABASE_URL=postgresql+psycopg://nv_worker:replace-with-worker-password@host.docker.internal:5432/noteverse_pro
SCHEDULER_LOCK_DATABASE_URL=postgresql+psycopg://nv_worker:replace-with-worker-password@host.docker.internal:5432/noteverse_pro
SCHEDULER_LOCK_STATEMENT_TIMEOUT_MILLISECONDS=5000
SCHEDULER_LOCK_TCP_USER_TIMEOUT_MILLISECONDS=30000
REDIS_URL=redis://host.docker.internal:6379/0
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/0
IMPORT_DISPATCH_INTERVAL_SECONDS=30
IMPORT_DISPATCH_TIMEOUT_SECONDS=300
IMPORT_PROCESSING_TIMEOUT_SECONDS=1200
IMPORT_DISPATCH_MAX_ATTEMPTS=3
IMPORT_DISPATCH_BATCH_SIZE=20
NOTIFICATION_CLEANUP_INTERVAL_SECONDS=86400
REALTIME_EVENT_CLEANUP_INTERVAL_SECONDS=86400
REALTIME_EVENT_RETENTION_DAYS=7
REVISION_RENDER_DISPATCH_INTERVAL_SECONDS=30
REVISION_RENDER_DISPATCH_TIMEOUT_SECONDS=300
REVISION_RENDER_PROCESSING_TIMEOUT_SECONDS=1200
REVISION_RENDER_RETRY_BASE_SECONDS=60
REVISION_RENDER_MAX_ATTEMPTS=5
REVISION_RENDER_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_DISPATCH_INTERVAL_SECONDS=10
MAIL_OUTBOX_DISPATCH_TIMEOUT_SECONDS=120
MAIL_OUTBOX_PROCESSING_TIMEOUT_SECONDS=120
MAIL_OUTBOX_RETRY_BASE_SECONDS=30
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=90
ORPHAN_UPLOAD_TTL_SECONDS=86400
S3_ENDPOINT_URL=https://s3.region.example.invalid
S3_SIGNED_ENDPOINT_URL=
S3_REGION=your-signing-region
S3_BUCKET=your-private-development-bucket
S3_ACCESS_KEY_ID=your-development-access-key
S3_SECRET_ACCESS_KEY=your-development-secret
S3_FORCE_PATH_STYLE=false
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=45
S3_MAX_ATTEMPTS=3
OBJECT_STORAGE_SIGNED_URL_EXPIRE_SECONDS=900
WORK_ROOT=data/work
MAIL_DEFAULT_SENDER=NoteVerse Pro <no-reply@example.com>
RESEND_API_KEY=re_your-api-key
AVATAR_MAX_UPLOAD_BYTES=5242880
SCORE_IMPORT_MAX_BYTES=20971520
TAKE_AUDIO_MAX_BYTES=524288000
TAKE_VIDEO_MAX_BYTES=2147483648
UPLOAD_SINGLE_PUT_MAX_BYTES=20971520
UPLOAD_PART_BYTES=16777216
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_CLIENT_CONCURRENCY=3
UPLOAD_MAX_ACTIVE_SESSIONS=5
UPLOAD_TEMP_BYTE_BUDGET=4294967296
TAKE_PROCESSING_MAX_ATTEMPTS=5
TAKE_PROCESSING_RETRY_SECONDS=60
TAKE_PROCESSING_LEASE_SECONDS=3600
CELERY_WORKER_CONCURRENCY=1
MAX_PROCESSING_TIME=900
CELERY_TASK_SOFT_TIME_LIMIT=960
CELERY_TASK_TIME_LIMIT=1020
MODEL_ROOT=/opt/noteverse/models
PLAYBACK_SOUNDFONT_PATH=/opt/noteverse/models/soundfonts/FluidR3_GM.sf2
HF_HOME=/opt/noteverse/models/huggingface
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=true
PADDLEOCR_MODEL_ROOT=/opt/noteverse/models/paddleocr/official_models
PADDLEOCR_DETECTION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-OCRv6_medium_det
PADDLEOCR_RECOGNITION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-OCRv6_medium_rec
PADDLEOCR_TEXTLINE_ORIENTATION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-LCNet_x1_0_textline_ori
PADDLEOCR_TIMEOUT_SECONDS=300
LEGATO_REPO_PATH=/opt/noteverse/legato
LEGATO_PYTHON=python3
LEGATO_DEVICE=cuda
LEGATO_FP16=true
LEGATO_BEAM_SIZE=10
LEGATO_BATCH_SIZE=1
LEGATO_TIMEOUT_SECONDS=600
