{
  "name": "noteverse-customer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "benchmark:practice-evaluation-scale": "node scripts/benchmark-practice-evaluation-scale.mjs",
    "benchmark:practice-timing": "node scripts/benchmark-practice-timing.mjs",
    "analyze:practice-midi-corpus": "node scripts/analyze-practice-midi-corpus.mjs",
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:i18n-errors": "node scripts/check-error-translations.mjs",
    "check:dead-code": "cross-env NEXT_BACKEND_ORIGIN=http://localhost:8000 AUTH_COOKIE_NAME=auth REFRESH_COOKIE_NAME=refresh knip --production --use-tsconfig-files",
    "generate:api-types": "openapi-ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "typecheck": "npm run check:tempo-policy && npm run check:acoustic-contract && npm run check:score-contract && npm run check:recording-media-admission && npm run check:recording-timebase-contract && tsc --noEmit",
    "check:recording-timebase-contract": "python ../../scripts/generate_practice_recording_timebase_contract.py --check",
    "check:recording-media-admission": "python ../../scripts/generate_practice_recording_media_admission.py --check",
    "check:score-contract": "python ../../scripts/generate_practice_score_contract.py --check",
    "check:tempo-policy": "python ../../scripts/generate_score_tempo_policy.py --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:integration": "node ./node_modules/@playwright/test/cli.js test -c playwright.integration.config.ts",
    "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "check:acoustic-contract": "python ../../scripts/generate_practice_acoustic_contract.py --check"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tonejs/midi": "^2.0.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.59.0",
    "midi-file": "1.2.4",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "onnxruntime-web": "1.20.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-easy-crop": "^6.2.4",
    "soundfont-player": "^0.12.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "verovio": "^6.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "4.3.2"
    }
  }
}
