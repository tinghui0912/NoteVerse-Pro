{
  "name": "noteverse-customer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:i18n-errors": "node scripts/check-error-translations.mjs",
    "generate:api-types": "openapi-ts",
    "generate:practice-api-types": "openapi-ts -f openapi-practice-ts.config.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:integration": "node ./node_modules/@playwright/test/cli.js test -c playwright.integration.config.ts",
    "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui"
  },
  "dependencies": {
