    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
