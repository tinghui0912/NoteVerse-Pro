FROM node:22-bookworm-slim AS deps

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci


FROM node:22-bookworm-slim AS builder

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

ARG NEXT_BACKEND_ORIGIN
ARG NEXT_PRACTICE_ORIGIN
ARG SESSION_COOKIE_NAME
ARG SESSION_REFRESH_COOKIE_NAME

ENV NEXT_BACKEND_ORIGIN=${NEXT_BACKEND_ORIGIN} \
    NEXT_PRACTICE_ORIGIN=${NEXT_PRACTICE_ORIGIN}

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

RUN test -n "$NEXT_BACKEND_ORIGIN" \
    && test -n "$NEXT_PRACTICE_ORIGIN" \
    && test -n "$SESSION_COOKIE_NAME" \
    && test -n "$SESSION_REFRESH_COOKIE_NAME" \
    && AUTH_COOKIE_NAME="$SESSION_COOKIE_NAME" REFRESH_COOKIE_NAME="$SESSION_REFRESH_COOKIE_NAME" npm run build \
    && npm prune --omit=dev


FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

ARG NEXT_BACKEND_ORIGIN
ARG NEXT_PRACTICE_ORIGIN

ENV NEXT_BACKEND_ORIGIN=${NEXT_BACKEND_ORIGIN} \
    NEXT_PRACTICE_ORIGIN=${NEXT_PRACTICE_ORIGIN}

WORKDIR /app

COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/package-lock.json ./package-lock.json
COPY --from=builder --chown=node:node /app/next.config.ts ./next.config.ts
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/public ./public

USER node

EXPOSE 3000

CMD ["npm", "run", "start"]
