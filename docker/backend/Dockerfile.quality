ARG PYTHON_IMAGE=ghcr.io/tinghui0912/noteverse/ml-base:py312-torch260-cu124
ARG MATCHMAKER_BUILD_IMAGE=python:3.12-slim-bookworm

FROM ${MATCHMAKER_BUILD_IMAGE} AS matchmaker-wheel

ENV PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install Cython==3.0.8 numpy==1.26.4 \
    && MATCHMAKER_REQ="$(grep -E '^pymatchmaker @' /tmp/requirements/practice.txt)" \
    && CFLAGS="-O1" python -m pip wheel --no-build-isolation --no-deps -w /wheels "${MATCHMAKER_REQ}"


FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        git \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/
COPY --from=matchmaker-wheel /wheels /tmp/wheels

RUN python - <<'PY' > /tmp/requirements/quality-core.txt
from pathlib import Path

seen: set[Path] = set()
skip_prefixes = ("pymatchmaker @", "paddleocr==")


def emit_requirements(path: Path) -> None:
    path = path.resolve()
    if path in seen:
        return
    seen.add(path)
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("-r "):
            emit_requirements(path.parent / line.split(maxsplit=1)[1])
            continue
        if line.startswith(skip_prefixes):
            continue
        print(raw_line)


emit_requirements(Path("/tmp/requirements/quality.txt"))
PY

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements/quality-core.txt \
    && python -m pip install paddlepaddle==3.2.0 -i "https://www.paddlepaddle.org.cn/packages/stable/cpu/" \
    && PADDLEOCR_REQ="$(grep -E '^paddleocr==' /tmp/requirements/worker.txt)" \
    && python -m pip install "${PADDLEOCR_REQ}" \
    && python -m pip install accelerate==1.8.0 --no-deps \
    && python -m pip install \
        fire==0.7.0 \
        Levenshtein \
        pyparsing \
        tqdm \
        transformers==4.54.0 \
        zss \
    && python -m pip install /tmp/wheels/pymatchmaker-*.whl \
    && rm -rf /tmp/wheels

COPY backend/ /app/

CMD ["bash"]
