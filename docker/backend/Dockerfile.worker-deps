ARG PYTHON_IMAGE=ghcr.io/tinghui0912/noteverse/ml-base:resolved-digest-required

FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        git \
        libaio1 \
        libasound2 \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

# The human-owned worker-image.in is compiled into this complete hashed lock.
# Version authority lives in the ownership inputs/generated lock, not RUN literals.
COPY backend/requirements/worker-image-py312-linux-amd64.lock /opt/noteverse/worker-python.lock
COPY backend/scripts/worker_lock.py /usr/local/lib/noteverse/worker_lock.py
COPY backend/scripts/check_image_contract.py /usr/local/lib/noteverse/check_image_contract.py

ARG INSTALL_PADDLE_GPU=false
ARG INSTALL_LEGATO_EXTRA_DEPS=false
RUN test "${INSTALL_PADDLE_GPU}" = "false" \
    && test "${INSTALL_LEGATO_EXTRA_DEPS}" = "false" \
    || { echo "Only the locked CPU Paddle / no LEGATO-extra target is supported; GPU needs separate qualification."; exit 1; }

# Bootstrap build tooling from the SAME lock, then prohibit untracked isolated
# build dependencies. Source distributions keep their source artifact hashes.
RUN python /usr/local/lib/noteverse/worker_lock.py --bootstrap-requirements --lock /opt/noteverse/worker-python.lock > /tmp/worker-bootstrap.lock \
    && python -m pip install --require-hashes -r /tmp/worker-bootstrap.lock \
    && python -m pip install --require-hashes --no-build-isolation -r /opt/noteverse/worker-python.lock \
    && python /usr/local/lib/noteverse/worker_lock.py --check-installed --lock /opt/noteverse/worker-python.lock \
    && rm -rf /root/.cache/pip /tmp/worker-bootstrap.lock

# The checker runs python -m pip check first; imports do not initialize models.
RUN python /usr/local/lib/noteverse/check_image_contract.py --role worker-deps

COPY backend/app/processing/engines/omr/legato_manifest.py /tmp/legato_manifest.py
RUN mkdir -p /opt/noteverse/models /opt/noteverse/legato \
    && LEGATO_REPO_URL="$(python -c 'import runpy; print(runpy.run_path("/tmp/legato_manifest.py")["LEGATO_REPOSITORY_URL"])')" \
    && LEGATO_REPO_COMMIT="$(python -c 'import runpy; print(runpy.run_path("/tmp/legato_manifest.py")["LEGATO_REPO_COMMIT"])')" \
    && git clone --filter=blob:none "${LEGATO_REPO_URL}" /opt/noteverse/legato \
    && cd /opt/noteverse/legato \
    && git fetch --depth 1 origin "${LEGATO_REPO_COMMIT}" \
    && git checkout --detach "${LEGATO_REPO_COMMIT}" \
    && find /opt/noteverse/legato -name '__pycache__' -type d -prune -exec rm -rf {} + \
    && rm -rf /opt/noteverse/legato/.git /root/.cache /tmp/legato_manifest.py

CMD ["bash"]
