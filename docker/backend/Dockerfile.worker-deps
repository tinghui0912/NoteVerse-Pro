ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/noteverse/venv \
    UV_PROJECT_ENVIRONMENT=/opt/noteverse/venv \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/noteverse/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        git \
        libaio1 \
        libasound2 \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

# The checked-in uv project is the sole dependency authority. --locked fails stale builds.
COPY --from=ghcr.io/astral-sh/uv@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /usr/local/bin/
COPY backend/pyproject.toml backend/uv.lock /opt/noteverse/project/
RUN uv sync --project /opt/noteverse/project --locked --no-default-groups --only-group worker --python /usr/local/bin/python --no-cache \
    && uv pip check --python /opt/noteverse/venv/bin/python

COPY backend/scripts/check_image_contract.py /usr/local/lib/noteverse/check_image_contract.py
RUN python /usr/local/lib/noteverse/check_image_contract.py --role worker-deps

COPY backend/app/processing/engines/omr/legato_manifest.py /tmp/legato_manifest.py
RUN mkdir -p /opt/noteverse/models /opt/noteverse/legato \
    && LEGATO_REPO_URL="$(python -c 'import runpy; print(runpy.run_path("/tmp/legato_manifest.py")["LEGATO_REPOSITORY_URL"])')" \
    && LEGATO_REPO_COMMIT="$(python -c 'import runpy; print(runpy.run_path("/tmp/legato_manifest.py")["LEGATO_REPO_COMMIT"])')" \
    && git clone --filter=blob:none "${LEGATO_REPO_URL}" /opt/noteverse/legato \
    && cd /opt/noteverse/legato \
    && git fetch --depth 1 origin "${LEGATO_REPO_COMMIT}" \
    && git checkout --detach "${LEGATO_REPO_COMMIT}" \
    && find /opt/noteverse/legato -name '__pycache__' -type d -prune -exec rm -rf {} + \
    && rm -rf /opt/noteverse/legato/.git /root/.cache /tmp/legato_manifest.py

ENV TMPDIR=/tmp HOME=/tmp XDG_CACHE_HOME=/tmp/.cache \
    MPLCONFIGDIR=/tmp/matplotlib TORCH_HOME=/tmp/torch \
    NUMBA_CACHE_DIR=/tmp/numba PADDLE_HOME=/tmp/paddle \
    RUFF_CACHE_DIR=/tmp/ruff MYPY_CACHE_DIR=/tmp/mypy UV_CACHE_DIR=/tmp/uv \
    WORK_ROOT=/tmp/work

RUN groupadd --gid 10001 noteverse && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp noteverse
USER 10001:10001

CMD ["bash"]
