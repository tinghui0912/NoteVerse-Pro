ARG PYTHON_IMAGE=ghcr.io/tinghui0912/noteverse/ml-base:py312-torch260-cu124-slim

FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        git \
        libaio1 \
        libasound2 \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/

ARG INSTALL_PADDLE_GPU=false
ARG INSTALL_LEGATO_EXTRA_DEPS=false
ARG PADDLE_CUDA_INDEX=cu126
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements/worker-app.txt \
    && python -m pip install protobuf==6.33.4 \
    && if [ "${INSTALL_PADDLE_GPU}" = "true" ]; then \
      python -m pip install paddlepaddle-gpu==3.2.0 --extra-index-url "https://www.paddlepaddle.org.cn/packages/stable/${PADDLE_CUDA_INDEX}/"; \
    else \
      python -m pip install paddlepaddle==3.2.0 --extra-index-url "https://www.paddlepaddle.org.cn/packages/stable/cpu/"; \
    fi \
    && PADDLEOCR_REQ="$(grep -E '^paddleocr==' /tmp/requirements/ocr.txt)" \
    && python -m pip install "${PADDLEOCR_REQ}" \
    && python -m pip install \
      accelerate==1.8.0 \
      fire==0.7.0 \
      Levenshtein \
      pyparsing \
      tqdm \
      transformers==4.54.0 \
      zss \
    && if [ "${INSTALL_LEGATO_EXTRA_DEPS}" = "true" ]; then \
      python -m pip install \
        datasets==3.2.0 \
        deepspeed \
        wandb; \
    fi \
    && rm -rf /root/.cache/pip /tmp/requirements

COPY backend/app/processing/engines/omr/legato_manifest.py /tmp/legato_manifest.py
RUN mkdir -p /opt/noteverse/models /opt/noteverse/legato \
    && LEGATO_REPO_URL="$(python -c 'import runpy; print(runpy.run_path("/tmp/legato_manifest.py")["LEGATO_REPOSITORY_URL"])')" \
    && LEGATO_REPO_COMMIT="$(python -c 'import runpy; print(runpy.run_path("/tmp/legato_manifest.py")["LEGATO_REPO_COMMIT"])')" \
    && git clone --filter=blob:none "${LEGATO_REPO_URL}" /opt/noteverse/legato \
    && cd /opt/noteverse/legato \
    && git fetch --depth 1 origin "${LEGATO_REPO_COMMIT}" \
    && git checkout --detach "${LEGATO_REPO_COMMIT}" \
    && find /opt/noteverse/legato -name '__pycache__' -type d -prune -exec rm -rf {} + \
    && rm -rf /opt/noteverse/legato/.git /root/.cache /tmp/legato_manifest.py

CMD ["bash"]
