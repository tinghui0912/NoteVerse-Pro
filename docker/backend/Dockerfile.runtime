ARG PYTHON_IMAGE=noteverse-ml-base:py312-torch260-cu124

FROM ${PYTHON_IMAGE} AS matchmaker-wheel

ENV PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install Cython==3.0.8 numpy==1.26.4 \
    && MATCHMAKER_REQ="$(grep -E '^pymatchmaker @' /tmp/requirements.txt)" \
    && CFLAGS="-O1" python -m pip wheel --no-build-isolation --no-deps -w /wheels "${MATCHMAKER_REQ}"


FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        libaio1 \
        libasound2 \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/requirements-dev.txt /tmp/requirements-dev.txt
COPY --from=matchmaker-wheel /wheels /tmp/wheels

ARG INSTALL_DEV_DEPS=true
RUN python -m pip install --upgrade pip setuptools wheel \
    && grep -vE '^(pymatchmaker @|paddleocr==)' /tmp/requirements.txt > /tmp/requirements-core.txt \
    && python -m pip install -r /tmp/requirements-core.txt \
    && python -m pip install /tmp/wheels/pymatchmaker-*.whl \
    && if [ "${INSTALL_DEV_DEPS}" = "true" ]; then \
      python -m pip install -r /tmp/requirements-dev.txt; \
    fi \
    && rm -rf /tmp/wheels

ARG INSTALL_GPU_DEPS=true
ARG INSTALL_PADDLE_GPU=false
ARG INSTALL_LEGATO_EXTRA_DEPS=false
ARG PADDLE_CUDA_INDEX=cu126
RUN if [ "${INSTALL_GPU_DEPS}" = "true" ]; then \
      # PyTorch comes from the selected base image. PaddleOCR defaults to CPU
      # Paddle because PyTorch CUDA runtimes and paddlepaddle-gpu can require
      # incompatible exact NVIDIA runtime packages in one Python environment.
      if [ "${INSTALL_PADDLE_GPU}" = "true" ]; then \
        python -m pip install paddlepaddle-gpu==3.2.0 -i "https://www.paddlepaddle.org.cn/packages/stable/${PADDLE_CUDA_INDEX}/"; \
      else \
        python -m pip install paddlepaddle==3.2.0 -i "https://www.paddlepaddle.org.cn/packages/stable/cpu/"; \
      fi \
      && PADDLEOCR_REQ="$(grep -E '^paddleocr==' /tmp/requirements.txt)" \
      && python -m pip install "${PADDLEOCR_REQ}" \
      && python -m pip install \
        accelerate==1.8.0 \
        fire==0.7.0 \
        Levenshtein \
        pyparsing \
        tqdm \
        transformers==4.54.0 \
        zss; \
    fi \
    && if [ "${INSTALL_LEGATO_EXTRA_DEPS}" = "true" ]; then \
      python -m pip install \
        datasets==3.2.0 \
        deepspeed \
        wandb; \
    fi

COPY docker/backend/entrypoint.sh /usr/local/bin/noteverse-entrypoint
RUN chmod +x /usr/local/bin/noteverse-entrypoint \
    && mkdir -p /app/data/storage /app/data/work /opt/noteverse/models

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--", "noteverse-entrypoint"]
CMD ["api"]
