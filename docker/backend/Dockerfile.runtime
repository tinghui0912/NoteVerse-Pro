ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        git \
        libasound2 \
        libffi-dev \
        libfluidsynth-dev \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libaio-dev \
        libsndfile1 \
        libssl-dev \
        ninja-build \
        pkg-config \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && grep -vE '^(pymatchmaker @|paddleocr==)' /tmp/requirements.txt > /tmp/requirements-core.txt \
    && python -m pip install -r /tmp/requirements-core.txt \
    && python -m pip install Cython==3.0.8 \
    && MATCHMAKER_REQ="$(grep -E '^pymatchmaker @' /tmp/requirements.txt)" \
    && CFLAGS="-O1" python -m pip install --no-build-isolation "${MATCHMAKER_REQ}"

ARG INSTALL_GPU_DEPS=true
ARG INSTALL_LEGATO_EXTRA_DEPS=false
ARG TORCH_CUDA_INDEX=cu126
ARG PADDLE_CUDA_INDEX=cu126
RUN if [ "${INSTALL_GPU_DEPS}" = "true" ]; then \
      # Keep PyTorch's version aligned with LEGATO and keep PyTorch/Paddle on
      # the same CUDA wheel family by default. CUDA 12.x is closer to LEGATO's
      # upstream tested environment than CUDA 11.8.
      python -m pip install torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}" \
      && python -m pip install paddlepaddle-gpu==3.2.0 -i "https://www.paddlepaddle.org.cn/packages/stable/${PADDLE_CUDA_INDEX}/" \
      && PADDLEOCR_REQ="$(grep -E '^paddleocr==' /tmp/requirements.txt)" \
      && python -m pip install "${PADDLEOCR_REQ}" \
      && python -m pip install \
        accelerate==1.8.0 \
        fire==0.7.0 \
        Levenshtein \
        pyparsing \
        tqdm \
        transformers==4.54.0 \
        zss; \
    fi \
    && if [ "${INSTALL_LEGATO_EXTRA_DEPS}" = "true" ]; then \
      python -m pip install \
        datasets==3.2.0 \
        deepspeed \
        wandb; \
    fi

COPY docker/backend/entrypoint.sh /usr/local/bin/noteverse-entrypoint
RUN chmod +x /usr/local/bin/noteverse-entrypoint \
    && mkdir -p /app/data/storage /app/data/work /opt/noteverse/models

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--", "noteverse-entrypoint"]
CMD ["api"]
