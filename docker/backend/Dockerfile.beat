FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libffi8 \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Beat retains its own narrow capability graph and complete generated resolution.
COPY backend/requirements/beat-image-py312-linux-amd64.lock /opt/noteverse/beat-python.lock
COPY backend/scripts/backend_service_lock.py /usr/local/lib/noteverse/backend_service_lock.py
COPY backend/requirements/beat-image.in \
     backend/requirements/beat.txt \
     backend/requirements/celery.txt \
     backend/requirements/cache.txt \
     backend/requirements/core.txt \
     /tmp/service-lock-source/backend/requirements/

RUN --network=none python /usr/local/lib/noteverse/backend_service_lock.py --role beat --check-inputs --repo /tmp/service-lock-source --lock /opt/noteverse/beat-python.lock

RUN python /usr/local/lib/noteverse/backend_service_lock.py --role beat --bootstrap-requirements --lock /opt/noteverse/beat-python.lock > /tmp/beat-bootstrap.lock \
    && python -m pip install --require-hashes -r /tmp/beat-bootstrap.lock \
    && python -m pip install --require-hashes --no-build-isolation -r /opt/noteverse/beat-python.lock \
    && python /usr/local/lib/noteverse/backend_service_lock.py --role beat --check-installed --lock /opt/noteverse/beat-python.lock \
    && python -m pip check \
    && rm /tmp/beat-bootstrap.lock

COPY docker/backend/entrypoint.sh /usr/local/bin/noteverse-entrypoint
RUN chmod +x /usr/local/bin/noteverse-entrypoint \
    && mkdir -p /app/data/work

COPY backend/ /app/
RUN test ! -e /app/research \
    && python /usr/local/lib/noteverse/backend_service_lock.py --role beat --check-installed --lock /opt/noteverse/beat-python.lock \
    && python -m pip check

ENTRYPOINT ["/usr/bin/tini", "--", "noteverse-entrypoint"]
CMD ["beat"]
