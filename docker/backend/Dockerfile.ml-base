ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

ARG TORCH_CUDA_INDEX=cu124

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install \
        --no-cache-dir \
        --no-compile \
        torch==2.6.0 \
        --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}" \
    && python -c "import sys, torch; assert sys.version_info[:2] == (3, 12), sys.version; assert torch.__version__.startswith('2.6.0'), torch.__version__; print('python', sys.version); print('torch', torch.__version__); print('cuda', torch.version.cuda)" \
    && rm -rf /root/.cache /tmp/*
