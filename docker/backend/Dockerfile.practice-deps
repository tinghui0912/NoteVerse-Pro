ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS matchmaker-wheel

ENV PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -c /tmp/requirements/practice-runtime-constraints.txt Cython==3.2.8 numpy==1.26.4 \
    && MATCHMAKER_REQ="$(grep -E '^pymatchmaker @' /tmp/requirements/practice-runtime.txt)" \
    && CFLAGS="-O0 -g0" MAKEFLAGS="-j1" python -m pip wheel --no-build-isolation --no-deps -w /wheels "${MATCHMAKER_REQ}"


FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_COMPILE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
        tini \
    && mkdir -p /opt/noteverse/models/soundfonts \
    && ln -sf /usr/share/sounds/sf2/FluidR3_GM.sf2 /opt/noteverse/models/soundfonts/FluidR3_GM.sf2 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/
COPY --from=matchmaker-wheel /wheels /tmp/wheels

RUN python -m pip install --upgrade pip setuptools wheel \
    && grep -vE '^pymatchmaker @' /tmp/requirements/practice-runtime.txt > /tmp/requirements/practice-runtime-core.txt \
    && python -m pip install -c /tmp/requirements/practice-runtime-constraints.txt -r /tmp/requirements/practice-app.txt -r /tmp/requirements/practice-runtime-core.txt \
    && python -m pip install -c /tmp/requirements/practice-runtime-constraints.txt /tmp/wheels/pymatchmaker-*.whl \
    && rm -rf /tmp/wheels

CMD ["bash"]
