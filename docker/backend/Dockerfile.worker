ARG WORKER_DEPS_IMAGE

FROM ${WORKER_DEPS_IMAGE}
USER 0:0

WORKDIR /app

COPY docker/backend/worker-entrypoint.sh /usr/local/bin/noteverse-entrypoint
RUN chmod +x /usr/local/bin/noteverse-entrypoint \
    && mkdir -p /app/data/work \
    && rm -rf /tmp/* /var/tmp/*

COPY backend/ /app/
RUN test ! -e /app/research

EXPOSE 8000

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp HOME=/tmp XDG_CACHE_HOME=/tmp/.cache \
    MPLCONFIGDIR=/tmp/matplotlib TORCH_HOME=/tmp/torch \
    NUMBA_CACHE_DIR=/tmp/numba PADDLE_HOME=/tmp/paddle \
    RUFF_CACHE_DIR=/tmp/ruff MYPY_CACHE_DIR=/tmp/mypy UV_CACHE_DIR=/tmp/uv \
    WORK_ROOT=/tmp/work

USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--", "noteverse-entrypoint"]
CMD ["worker"]
