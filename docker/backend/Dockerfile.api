ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libffi8 \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Copy the API dependency closure only. A Beat/worker-only requirements change
# must not invalidate this image's dependency layer.
COPY backend/requirements/api.txt \
     backend/requirements/auth.txt \
     backend/requirements/cache.txt \
     backend/requirements/celery.txt \
     backend/requirements/core.txt \
     backend/requirements/db.txt \
     backend/requirements/fingering.txt \
     backend/requirements/http.txt \
     backend/requirements/image.txt \
     backend/requirements/migrations.txt \
     backend/requirements/storage.txt \
     /tmp/requirements/

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements/api.txt

COPY docker/backend/entrypoint.sh /usr/local/bin/noteverse-entrypoint
RUN chmod +x /usr/local/bin/noteverse-entrypoint \
    && mkdir -p /app/data/storage /app/data/work

COPY backend/ /app/

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--", "noteverse-entrypoint"]
CMD ["api"]
