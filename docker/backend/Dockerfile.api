ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS matchmaker-wheel

ENV PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install Cython==3.0.8 numpy==1.26.4 \
    && MATCHMAKER_REQ="$(grep -E '^pymatchmaker @' /tmp/requirements/api.txt)" \
    && CFLAGS="-O1" python -m pip wheel --no-build-isolation --no-deps -w /wheels "${MATCHMAKER_REQ}"


FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fluid-soundfont-gm \
        fluidsynth \
        libffi8 \
        libfluidsynth3 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsndfile1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/ /tmp/requirements/
COPY --from=matchmaker-wheel /wheels /tmp/wheels

RUN python -m pip install --upgrade pip setuptools wheel \
    && grep -vE '^pymatchmaker @' /tmp/requirements/api.txt > /tmp/requirements/api-core.txt \
    && python -m pip install -r /tmp/requirements/api-core.txt \
    && python -m pip install /tmp/wheels/pymatchmaker-*.whl \
    && rm -rf /tmp/wheels

COPY docker/backend/entrypoint.sh /usr/local/bin/noteverse-entrypoint
RUN chmod +x /usr/local/bin/noteverse-entrypoint \
    && mkdir -p /app/data/storage /app/data/work

COPY backend/ /app/

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--", "noteverse-entrypoint"]
CMD ["api"]
