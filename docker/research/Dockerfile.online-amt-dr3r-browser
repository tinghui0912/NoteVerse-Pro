FROM noteverse-online-amt-dr3r:latest

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gnupg \
      xvfb \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY backend/research/browser_runtime/dr3r_browser_runtime/package.json /opt/dr3r-browser-runtime/package.json
COPY backend/research/browser_runtime/dr3r_browser_runtime/package-lock.json /opt/dr3r-browser-runtime/package-lock.json

WORKDIR /opt/dr3r-browser-runtime
RUN npm ci \
    && npx playwright install --with-deps chrome msedge

WORKDIR /workspace
ENV DR3R_BROWSER_NODE_MODULES=/opt/dr3r-browser-runtime/node_modules
ENV DR3R_ORT_WEB_DIST=/opt/dr3r-browser-runtime/node_modules/onnxruntime-web/dist
