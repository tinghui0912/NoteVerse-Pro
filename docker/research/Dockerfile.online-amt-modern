FROM python:3.11.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      git-lfs \
      libsndfile1 \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY docker/research/requirements.online-amt-modern.txt /tmp/requirements.online-amt-modern.txt
RUN pip install --no-cache-dir -r /tmp/requirements.online-amt-modern.txt

CMD ["python", "--version"]
