ARG NODE_IMAGE=node:24-bookworm-slim
ARG NPM_VERSION=12.0.2

FROM ${NODE_IMAGE} AS node-base

ARG NPM_VERSION

RUN npm install -g "npm@${NPM_VERSION}" \
    && npm cache clean --force


FROM node-base AS deps

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY apps/platform-admin/package.json apps/platform-admin/package-lock.json ./
RUN npm ci


FROM node-base AS builder

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

ARG NEXT_CONTROL_PLANE_ORIGIN
ARG NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME
ARG NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME

ENV NEXT_CONTROL_PLANE_ORIGIN=${NEXT_CONTROL_PLANE_ORIGIN} \
    NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME=${NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME} \
    NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME=${NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME}

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY apps/platform-admin/ ./

RUN test -n "$NEXT_CONTROL_PLANE_ORIGIN" \
    && test -n "$NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME" \
    && test -n "$NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME" \
    && npm run build \
    && npm prune --omit=dev


FROM node-base AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

ARG NEXT_CONTROL_PLANE_ORIGIN
ARG NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME
ARG NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME

ENV NEXT_CONTROL_PLANE_ORIGIN=${NEXT_CONTROL_PLANE_ORIGIN} \
    NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME=${NEXT_PUBLIC_CONTROL_PLANE_CSRF_COOKIE_NAME} \
    NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME=${NEXT_PUBLIC_CONTROL_PLANE_CSRF_HEADER_NAME}

WORKDIR /app

COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/package-lock.json ./package-lock.json
COPY --from=builder --chown=node:node /app/next.config.ts ./next.config.ts
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next

USER node

EXPOSE 3000

CMD ["npm", "run", "start"]
