ARG NODE_IMAGE=node:24-bookworm-slim
ARG NPM_VERSION=12.0.2

FROM ${NODE_IMAGE} AS node-base

ARG NPM_VERSION

RUN npm install -g "npm@${NPM_VERSION}" \
    && npm cache clean --force


FROM node-base AS deps

ENV NEXT_TELEMETRY_DISABLED=1

ENV TMPDIR=/tmp HOME=/tmp npm_config_cache=/tmp/npm

WORKDIR /app

COPY apps/platform-admin/package.json apps/platform-admin/package-lock.json ./
RUN npm ci


FROM node-base AS builder

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

ENV TMPDIR=/tmp HOME=/tmp npm_config_cache=/tmp/npm

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY apps/platform-admin/ ./

RUN npm run build \
    && npm prune --omit=dev


FROM node-base AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

ENV TMPDIR=/tmp HOME=/tmp npm_config_cache=/tmp/npm

WORKDIR /app

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY --from=builder /app/generated/browser-protocol.ts ./generated/browser-protocol.ts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next

RUN groupadd --gid 10001 noteverse && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp noteverse
USER 10001:10001

EXPOSE 3000

CMD ["npm", "run", "start"]
