ARG NODE_IMAGE=node:24-bookworm-slim
ARG NPM_VERSION=12.0.1

FROM ${NODE_IMAGE} AS node-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade perl-base \
    && rm -rf /var/lib/apt/lists/*

ARG NPM_VERSION

RUN npm install -g "npm@${NPM_VERSION}" \
    && node -e "const version = require('/usr/local/lib/node_modules/npm/node_modules/tar/package.json').version; const [major, minor, patch] = version.split('.').map(Number); if (major < 7 || (major === 7 && (minor < 5 || (minor === 5 && patch < 19)))) { throw new Error('npm bundled tar ' + version + ' is below 7.5.19'); }" \
    && npm cache clean --force


FROM node-base AS deps

ENV NEXT_TELEMETRY_DISABLED=1

ENV TMPDIR=/tmp HOME=/tmp npm_config_cache=/tmp/npm

WORKDIR /app

COPY apps/customer-web/package.json apps/customer-web/package-lock.json ./
RUN npm ci


FROM node-base AS builder

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

ENV TMPDIR=/tmp HOME=/tmp npm_config_cache=/tmp/npm

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY apps/customer-web/ ./
COPY backend/tests/fixtures/verovio-written-realization.json backend/tests/fixtures/verovio-playback-profile.json /backend/tests/fixtures/

RUN npm run build \
    && npm prune --omit=dev


FROM node-base AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

ENV TMPDIR=/tmp HOME=/tmp npm_config_cache=/tmp/npm

WORKDIR /app

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY --from=builder /app/src/generated/browser-protocol.ts ./src/generated/browser-protocol.ts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

RUN groupadd --gid 10001 noteverse && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp noteverse
USER 10001:10001

EXPOSE 3000

CMD ["npm", "run", "start"]
