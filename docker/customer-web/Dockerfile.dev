ARG NODE_IMAGE=node:24-bookworm-slim
ARG NPM_VERSION=12.0.1

FROM ${NODE_IMAGE}

ARG NPM_VERSION

RUN npm install -g "npm@${NPM_VERSION}" \
    && node -e "const version = require('/usr/local/lib/node_modules/npm/node_modules/tar/package.json').version; const [major, minor, patch] = version.split('.').map(Number); if (major < 7 || (major === 7 && (minor < 5 || (minor === 5 && patch < 19)))) { throw new Error('npm bundled tar ' + version + ' is below 7.5.19'); }" \
    && npm cache clean --force

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=development

WORKDIR /app

COPY apps/customer-web/package.json apps/customer-web/package-lock.json ./
RUN npm ci \
    && sha256sum package-lock.json | cut -d ' ' -f 1 > node_modules/.noteverse-package-lock.sha256

COPY docker/customer-web/entrypoint.dev.sh /usr/local/bin/customer-web-dev-entrypoint
RUN chmod +x /usr/local/bin/customer-web-dev-entrypoint

EXPOSE 9002

ENTRYPOINT ["customer-web-dev-entrypoint"]
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
