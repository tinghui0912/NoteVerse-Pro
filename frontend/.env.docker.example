NEXT_BACKEND_ORIGIN=http://host.docker.internal:8000
NEXT_ALLOWED_DEV_ORIGINS=
AUTH_COOKIE_NAME=noteverse_session
REFRESH_COOKIE_NAME=noteverse_refresh
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Browser-reachable realtime API base URL. Keep the hostname consistent with
# the frontend URL you open in the browser so HttpOnly cookies are sent.
NEXT_PUBLIC_REALTIME_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CSRF_COOKIE_NAME=noteverse_csrf
NEXT_PUBLIC_CSRF_HEADER_NAME=x-csrf-token
