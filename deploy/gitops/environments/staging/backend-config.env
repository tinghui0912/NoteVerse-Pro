PROJECT_NAME=NoteVerse Pro
API_V1_STR=/api/v1
DEBUG=false
FRONTEND_BASE_URL=https://staging.johnabc.ccwu.cc
LOG_FORMAT=json
PORT=8000
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=noteverse-backend-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-opentelemetry-collector.observability.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true

ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_NAME=noteverse_session
REFRESH_COOKIE_NAME=noteverse_refresh
CSRF_COOKIE_NAME=noteverse_csrf
CSRF_HEADER_NAME=x-csrf-token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

BACKEND_CORS_ORIGINS=["https://staging.johnabc.ccwu.cc"]
TRUSTED_PROXY_CIDRS=["10.244.0.0/16"]

FILE_STORAGE_BACKEND=s3
STORAGE_ROOT=/var/lib/noteverse/storage
WORK_ROOT=/var/lib/noteverse/work
MAX_PROCESSING_TIME=900
PADDLEOCR_TIMEOUT_SECONDS=300
FINGERING_MAX_CONCURRENCY=2
FINGERING_QUEUE_WAIT_SECONDS=5
FINGERING_MAX_CONTENT_BYTES=2097152
CELERY_TASK_SOFT_TIME_LIMIT=960
CELERY_TASK_TIME_LIMIT=1020
CELERY_WORKER_CONCURRENCY=1

S3_ENDPOINT_URL=https://oss-cn-shenzhen.aliyuncs.com
S3_REGION=cn-shenzhen
S3_BUCKET=noteverse
S3_PUBLIC_BASE_URL=https://noteverse.oss-cn-shenzhen.aliyuncs.com
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRE_SECONDS=900

MODEL_ROOT=/opt/noteverse/models
PRACTICE_SOUNDFONT_PATH=/opt/noteverse/models/soundfonts/FluidR3_GM.sf2
PLAYBACK_SOUNDFONT_PATH=/opt/noteverse/models/soundfonts/FluidR3_GM.sf2
PLAYBACK_SAMPLE_RATE=44100
PLAYBACK_MAX_DURATION_SECONDS=180
HF_HOME=/opt/noteverse/models/huggingface
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=true
PADDLEOCR_MODEL_ROOT=/opt/noteverse/models/paddleocr/official_models
PADDLEOCR_DETECTION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-OCRv6_medium_det
PADDLEOCR_RECOGNITION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-OCRv6_medium_rec
PADDLEOCR_TEXTLINE_ORIENTATION_MODEL_DIR=/opt/noteverse/models/paddleocr/official_models/PP-LCNet_x1_0_textline_ori

LEGATO_REPO_PATH=/opt/noteverse/legato
LEGATO_PYTHON=python3
LEGATO_DEVICE=cuda
LEGATO_FP16=true
LEGATO_BEAM_SIZE=10
LEGATO_BATCH_SIZE=1
LEGATO_TIMEOUT_SECONDS=600


IMPORT_DISPATCH_INTERVAL_SECONDS=30
IMPORT_DISPATCH_TIMEOUT_SECONDS=300
IMPORT_PROCESSING_TIMEOUT_SECONDS=1200
IMPORT_DISPATCH_MAX_ATTEMPTS=3
IMPORT_DISPATCH_BATCH_SIZE=20
JOB_PENDING_STALE_SECONDS=600
JOB_PROGRESS_STALE_SECONDS=900
ORPHAN_UPLOAD_TTL_SECONDS=86400

RENDER_OUTBOX_DISPATCH_INTERVAL_SECONDS=30
RENDER_OUTBOX_DISPATCH_TIMEOUT_SECONDS=300
RENDER_OUTBOX_PROCESSING_TIMEOUT_SECONDS=1200
RENDER_OUTBOX_RETRY_BASE_SECONDS=60
RENDER_OUTBOX_MAX_ATTEMPTS=5
RENDER_OUTBOX_DISPATCH_BATCH_SIZE=50

PLAYBACK_OUTBOX_DISPATCH_INTERVAL_SECONDS=30
PLAYBACK_OUTBOX_DISPATCH_TIMEOUT_SECONDS=300
PLAYBACK_OUTBOX_PROCESSING_TIMEOUT_SECONDS=1200
PLAYBACK_OUTBOX_RETRY_BASE_SECONDS=60
PLAYBACK_OUTBOX_MAX_ATTEMPTS=5
PLAYBACK_OUTBOX_DISPATCH_BATCH_SIZE=50

MAIL_OUTBOX_DISPATCH_INTERVAL_SECONDS=10
MAIL_OUTBOX_DISPATCH_TIMEOUT_SECONDS=120
MAIL_OUTBOX_PROCESSING_TIMEOUT_SECONDS=120
MAIL_OUTBOX_RETRY_BASE_SECONDS=30
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_DISPATCH_BATCH_SIZE=50
MAIL_OUTBOX_RETENTION_DAYS=7

NOTIFICATION_CLEANUP_INTERVAL_SECONDS=86400
NOTIFICATION_RETENTION_DAYS=90
REALTIME_EVENT_CATCHUP_INTERVAL_SECONDS=2
REALTIME_EVENT_HEARTBEAT_INTERVAL_SECONDS=15
REALTIME_EVENT_BATCH_SIZE=100
REALTIME_EVENT_CLEANUP_INTERVAL_SECONDS=86400
REALTIME_EVENT_RETENTION_DAYS=7
DERIVED_ASSET_RETAIN_RECENT_REVISIONS=10
DERIVED_ASSET_CLEANUP_INTERVAL_SECONDS=86400
SCORE_DELETION_CLEANUP_INTERVAL_SECONDS=60
SCORE_DELETION_CLEANUP_BATCH_SIZE=20
SCORE_DELETION_CLEANUP_RETRY_BASE_SECONDS=60
SCORE_DELETION_CLEANUP_MAX_ATTEMPTS=10

PRACTICE_MATCHMAKER_FRAME_RATE=30
PRACTICE_AUDIO_RMS_GATE=0.015
PRACTICE_AUDIO_PEAK_GATE=0.06
PRACTICE_AUDIO_START_RMS_GATE=0.025
PRACTICE_AUDIO_START_PEAK_GATE=0.06
PRACTICE_AUDIO_MIN_ACTIVE_FRAMES=3
PRACTICE_AUDIO_WARMUP_FRAMES=30
PRACTICE_AUDIO_RMS_NOISE_MULTIPLIER=4.0
PRACTICE_AUDIO_PEAK_NOISE_MULTIPLIER=2.5
PRACTICE_AUDIO_NO_INPUT_FRAMES=24
PRACTICE_AUDIO_TONAL_GATE_ENABLED=true
PRACTICE_AUDIO_MAX_SPECTRAL_FLATNESS=0.35
PRACTICE_AUDIO_MIN_PEAK_PROMINENCE=8.0
PRACTICE_AUDIO_ONSET_FLUX_GATE=0.35
PRACTICE_AUDIO_ONSET_HOLD_FRAMES=45
PRACTICE_AUDIO_DIAGNOSTICS=false
PRACTICE_AUDIO_DIAGNOSTIC_FRAME_INTERVAL=15
PRACTICE_ALIGNMENT_DIAGNOSTIC_UPDATE_INTERVAL=15

MAIL_DEFAULT_SENDER=NoteVerse Pro <no-reply@staging.johnabc.ccwu.cc>
RESEND_API_URL=https://api.resend.com/emails
EMAIL_PASSWORD_RESET_TOKEN_TTL_SECONDS=300
EMAIL_VERIFY_TOKEN_MAX_AGE_SECONDS=900
