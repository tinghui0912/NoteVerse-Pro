{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "https://customer.example.invalid"
      ],
      "AllowedMethods": [
        "PUT",
        "GET",
        "HEAD"
      ],
      "AllowedHeaders": [
        "content-type",
        "content-length",
        "range",
        "x-amz-checksum-*"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Content-Range",
        "Accept-Ranges",
        "x-amz-checksum-sha256",
        "x-amz-checksum-type"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
